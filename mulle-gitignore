print_flags()
{
   echo "   --rm    : remove matching entries instead of adding them"
   echo "   --stdin : read file values from stdin instead"
   options_technical_flags_usage "   : "
}


usage()
{
   [ $# -ne 0 ] && log_error "$*"


   cat <<EOF >&2
Usage:
   mulle-gitignore [flags] <file>

   Add a file or directory to the .gitignore file, if it's not already present.
   Add patterns in single quotes like for example \`*.old\`.
   Use \`--rm\` to remove matching entries from the .gitignore file instead.

Flags:
EOF
   print_flags | LC_ALL=C sort >&2

   exit 1
}


append_to_gitignore_if_needed()
{
   local file="$1"

   r_trim_whitespace "${file}"
   file="${RVAL}"

   case "${file}" in
      ""|\#*)
         # log_warning 'Fool! Don''t add comments this way!'
         return
      ;;
   esac

   local line

   if [ -f ".gitignore" ]
   then
      case "${file}" in
         */*)
            local directory

            directory="${file##/}"
            directory="${directory%%/}"

            local pattern0
            local pattern1
            local pattern2
            local pattern3

            # variations with leading and trailing slashes
            pattern0="${directory}"
            pattern1="${directory}/"
            pattern2="/${directory}"
            pattern3="/${directory}/"

            if rexekutor grep -F -q -s -x -e "${pattern0}" .gitignore
            then
               log_verbose "Duplicate ${C_RESET_BOLD}${pattern0}${C_VERBOSE} found"
               return
            fi
            if rexekutor grep -F -q -s -x -e "${pattern1}" .gitignore
            then
               log_verbose "Duplicate ${C_RESET_BOLD}${pattern1}${C_VERBOSE} found"
               return
            fi
            if rexekutor grep -F -q -s -x -e "${pattern2}" .gitignore
            then
               log_verbose "Duplicate ${C_RESET_BOLD}${pattern2}${C_VERBOSE} found"
               return
            fi
            if rexekutor grep -F -q -s -x -e "${pattern3}" .gitignore
            then
               log_verbose "Duplicate ${C_RESET_BOLD}${pattern3}${C_VERBOSE} found"
               return
            fi
         ;;

         *)
            if rexekutor grep -F -q -s -x -e "${file}" .gitignore
            then
               log_verbose "Duplicate ${C_RESET_BOLD}${file}${C_VERBOSE} found"
               return
            fi
         ;;
      esac
   fi

   #
   # prepend \n because it is safer, in case .gitignore has no trailing
   # LF which it often seems to not have
   # grep -F is bugged on at least OS X 10.x, so can't use -e chaining

   local terminator

   line="${file}"
   terminator="`rexekutor tail -c 1 ".gitignore" 2> /dev/null | tr '\012' '|'`"

   if [ ! -z "${terminator}" -a "${terminator}" != "|" ]
   then
      line=$'\n'"${line}"
   fi

   log_info "Adding \"${file}\" to \".gitignore\""
   redirect_append_exekutor .gitignore printf "%s\n" "${line}" || fail "Couldn't append to .gitignore"
}


remove_from_gitignore_if_needed()
{
   local file="$1"

   r_trim_whitespace "${file}"
   file="${RVAL}"

   case "${file}" in
      ""|\#*)
         return
      ;;
   esac

   [ -f ".gitignore" ] || return

   # accept both "foo" and "!foo", drop either form
   file="${file#!}"

   #
   # Build the variations that the append side considers equivalent, with
   # and without a leading '!', so a removal catches whatever is there.
   #
   local p0 p1 p2 p3 n0 n1 n2 n3
   local directory

   case "${file}" in
      */*)
         directory="${file##/}"
         directory="${directory%%/}"

         p0="${directory}"
         p1="${directory}/"
         p2="/${directory}"
         p3="/${directory}/"
      ;;

      *)
         p0="${file}"
         p1="${file}/"
      ;;
   esac

   n0="!${p0}"
   [ ! -z "${p1}" ] && n1="!${p1}"
   [ ! -z "${p2}" ] && n2="!${p2}"
   [ ! -z "${p3}" ] && n3="!${p3}"

   local output

   output="`mktemp`" || fail "Couldn't create temporary file"

   local pattern
   local line
   local skip
   local removed='NO'

   while IFS= read -r line || [ ! -z "${line}" ]
   do
      skip='NO'

      for pattern in "${p0}" "${p1}" "${p2}" "${p3}" "${n0}" "${n1}" "${n2}" "${n3}"
      do
         if [ ! -z "${pattern}" -a "${line}" = "${pattern}" ]
         then
            skip='YES'
            removed='YES'
            break
         fi
      done

      if [ "${skip}" = 'NO' ]
      then
         printf '%s\n' "${line}"
      fi
   done < .gitignore > "${output}"

   if [ "${removed}" = 'NO' ]
   then
      rm -f "${output}"
      log_verbose "No entry matching ${C_RESET_BOLD}${file}${C_VERBOSE} found"
      return
   fi

   log_info "Removing \"${file}\" from \".gitignore\""
   redirect_exekutor .gitignore cat "${output}" || fail "Couldn't update .gitignore"
   rm -f "${output}"
}


process_gitignore_if_needed()
{
   if [ "${FLAG_RM}" = 'YES' ]
   then
      remove_from_gitignore_if_needed "$1"
   else
      append_to_gitignore_if_needed "$1"
   fi
}



main()
{
   local FLAG_STDIN='NO'
   local FLAG_RM='NO'

   #
   # simple flag handling
   #
   while [ $# -ne 0 ]
   do
      if options_technical_flags "$1"
      then
         shift
         continue
      fi

      case "$1" in
         -f|--force)
            MULLE_FLAG_MAGNUM_FORCE='YES'
         ;;

         -h*|--help|help)
            usage
         ;;

         -r|--rm)
            FLAG_RM='YES'
         ;;

         --stdin)
            FLAG_STDIN='YES'
         ;;

         --version)
            printf "%s\n" "${MULLE_EXECUTABLE_VERSION}"
            exit 0
         ;;

         ##
         ## ADD YOUR FLAGS HERE
         ##

         -*)
            usage "Unknown flag \"$1\""
         ;;

         *)
            break
         ;;
      esac

      shift
   done

   options_setup_trace "${MULLE_TRACE}" && set -x

   local line

   if [ "${FLAG_STDIN}" = 'YES' ]
   then
      while IFS=$'\n' read -r line
      do
         process_gitignore_if_needed "${line}"
      done
      return 0
   fi

   [ $# -eq 0 ] && usage "Missing file"

   .foreachline line in "$@"
   .do
      process_gitignore_if_needed "${line}"
   .done
}


call_with_flags "main" "${MULLE_PROJECT_VERSIONCHECK_FLAGS}" "$@"
