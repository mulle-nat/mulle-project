#! /usr/bin/env mulle-bash
# shellcheck shell=bash

[ "${TRACE}" = 'YES' -o "${MULLE_PROJECT_CI_SETTINGS_TRACE}" = 'YES' ] && set -x && : "$0" "$@"

MULLE_EXECUTABLE_VERSION="0.0.0"

if [ -z "${MULLE_PROJECT_LIBEXEC_DIR}" ]
then
   r_get_libexec_dir "${MULLE_EXECUTABLE}" "mulle-project" "mulle-project-git.sh"
   MULLE_PROJECT_LIBEXEC_DIR="${RVAL}"
fi


print_flags()
{
   echo "   -f               : force operation, repair and refetch the sourcetree"

   ##
   ## ADD YOUR FLAGS HERE
   ##

   options_technical_flags_usage \
                "            : "
}


usage()
{
   [ $# -ne 0 ] && log_error "$*"


   cat <<EOF >&2
Usage:
   mulle-project-ci-settings [flags]

   Generate environment variable settings to map the sourcetree dependencies to
   a different branch, nodetype, url. This is useful for testing prereleases
   with github actions, where you want to clone from a different branch rather
   than downloading a tagged archive from release.

   On Github actions, with the default flag values, set MULLE_HOSTNAME to
   "ci-prerelease" in the settings. This will be picked up and the
   environment variables will be used in the next build.

   It is important for this command to work, that all dependencies have been
   fetched. This is not as easy as it may sound, especially if you use 
   symlinks. It is important to do the cleaning and fetching in the proper
   order. All symlinked dependencies are also completely fetched:

   mulle-sde clean tidy ; mulle-sde clean fetch
   mulle-sde test clean tidy ; mulle-sde test fetch

   The command verifies the sourcetree database with "mulle-sourcetree
   dbstatus" before it writes anything. If the database is stale or missing,
   it repairs it automatically with "mulle-sde clean tidy" and, unless
   --no-fetch is given, "mulle-sde clean fetch" followed by "mulle-sde fetch".
   Only if the database still cannot be made usable does it fail, so that an
   incomplete settings file is never generated. Use --no-fix to skip the
   automatic repair and fail immediately instead.

Example:
   mulle-project-ci-settings --user 'mulle-*' --user '!mintomic'

Flags:
   --user <pattern> : specify github users to match in the URL of the
                      dependency. Multiple users and wildcards are possible
   --repo <pattern> : specify repository names to match in the URL of the
                      dependency. Multiple uses and wildcards are possible
   --branch <name>  : specify github branch to pull from (prerelease)
   --scope <name>   : specify environment scope (host-ci-prerelease)
   --mulle          : standard values for mulle-c/mulle-objc projects
   --append         : don't overwrite existing file completely
   --fetch          : allow the automatic repair to refetch from remotes
                      (default)
   --no-fetch       : repair locally only, never touch the network
   --no-fix         : don't repair, fail if the database is not usable

EOF
   print_flags | LC_ALL=C sort >&2

   exit 1
}


repair_sourcetree()
{
   log_entry repair_sourcetree "$@"

   local do_fetch="$1"

   log_info "Repairing sourcetree database (mulle-sde clean tidy)"

   exekutor mulle-sde \
               ${MULLE_TECHNICAL_FLAGS} \
            --no-test-check \
            clean tidy || return $?

   if [ "${do_fetch}" = 'YES' ]
   then
      log_info "Refetching dependencies (mulle-sde clean fetch ; mulle-sde fetch)"

      exekutor mulle-sde \
                  ${MULLE_TECHNICAL_FLAGS} \
               --no-test-check \
               clean fetch || return $?

      exekutor mulle-sde \
                  ${MULLE_TECHNICAL_FLAGS} \
               --no-test-check \
               fetch || return $?
   fi
}


produce_environment()
{
   log_entry produce_environment "$@"

   local mapped_branch="$1"
   local mapped_scope="$2"
   local matching_users="$3"
   local matching_repos="$4"
   local clobber="$5"
   local fix="$6"
   local fetch="$7"

   if [ -z "${MULLE_VIRTUAL_ROOT}" ]
   then
      if [ ! -e .mulle/share/env/environment.sh ]
      then
         fail "Not a mulle environment"
      fi
      . ".mulle/share/env/environment.sh"
   fi

   [ -z "${mapped_branch}" ] && _internal_fail "mapped_branch is empty"
   [ -z "${mapped_scope}" ]  && _internal_fail "mapped_scope is empty"

   #
   # The dependency listing is only trustworthy while the sourcetree database
   # is complete. A stale or missing database makes mulle-sourcetree list emit
   # an incomplete set (with only a warning on stderr) yet still exit
   # successfully, which used to silently produce a settings file with missing
   # transitive dependencies. Verify the database and, unless disabled, repair
   # it before writing anything.
   #
   local dbstatus

   project::sourcetree_parser::r_database_status
   dbstatus=$?

   if [ ${dbstatus} -eq 1 ]
   then
      log_warning "No sourcetree here.
Nothing to write to scope '${mapped_scope}'."
      return 0
   fi

   if [ ${dbstatus} -ne 0 ] && [ "${fix}" = 'YES' ]
   then
      project::sourcetree_parser::r_database_status_description "${dbstatus}"
      log_warning "Sourcetree database not usable (${dbstatus}: ${RVAL}), repairing"

      repair_sourcetree "${fetch}" || fail "Could not repair sourcetree database"

      project::sourcetree_parser::r_database_status
      dbstatus=$?
   fi

   if [ ${dbstatus} -ne 0 ]
   then
      project::sourcetree_parser::r_database_status_description "${dbstatus}"

      fail "Sourcetree database is not usable (${dbstatus}: ${RVAL}).
Refusing to generate CI settings from an incomplete dependency listing.

Let this command repair it with --fetch, or do it manually:
   mulle-sde clean tidy ; mulle-sde clean fetch ; mulle-sde fetch

Use --no-fix to check without repairing."
   fi

   local lines

   #
   # uses mulle-sourcetree-parser library
   #
   # ignore amalgamated
   lines="`project::sourcetree_parser::get_dependency_address_nodetype_branch_tag_url -r --bequeath --qualifier "MATCHES share-shirk"`"

   local _address
   local _nodetype
   local _branch
   local _url
   local _host
   local _user
   local _repo
   local _nodetype_identifier
   local _nodetype_fallback
   local _branch_identifier
   local _branch_fallback
   local _url_identifier
   local _url_fallback
   local _tag_identifier
   local _tag_fallback

   local mapped_url
   local line
   local mapped_count=0
   local matching_lines

   log_debug "lines: ${lines}"

   #
   # First pass: determine which dependencies would be mapped. This runs
   # before the existing scope/file is touched, so that a failure never
   # destroys prior settings and a partial result is never written.
   #
   .foreachline line in ${lines}
   .do
      [ -z "${line}" ] && .continue

      if ! project::sourcetree_parser::parse_nodetype_branch_tag_url "${line}"
      then
         .continue
      fi

      [ -z "${_address}" ] && fail "Can't figure out address: ${line}"

      #
      # Skip dependencies that do not match the user/repo filter BEFORE the
      # stricter identifier validation. A non-matching dependency (e.g. a
      # third-party tar dep with a templated URL) may legitimately lack an
      # override identifier and must not abort the whole run.
      #
      if [ ! -z "${_user}" ] && ! project::sourcetree_parser::is_matching_wildcards "${matching_users}" "${_user}"
      then
         log_fluff "\"${_user}\" does not match \"${matching_users}\""
         .continue
      fi
      if [ ! -z "${_repo}" ] && ! project::sourcetree_parser::is_matching_wildcards "${matching_repos}" "${_repo}"
      then
         log_fluff "\"${_repo}\" does not match \"${matching_repos}\""
         .continue
      fi

      #
      # A dependency can only be remapped when its nodetype/url/branch are
      # written as overridable variables, e.g. \${FOO_URL:-https://...}. The
      # parser only yields an override identifier for that form. Such
      # identifiers are produced by mulle-project-add-missing-branch-identifier.
      #
      # A literal value has no identifier and therefore cannot be redirected.
      # Skip it with a warning instead of aborting the whole run. Note that
      # deriving an identifier here would be wrong: it would remap e.g. a
      # third-party tar dependency to an unrelated git repository.
      #
      # Validate everything the second pass relies on, so that applying the
      # mappings cannot fail after the existing scope has been replaced.
      #
      case "${_nodetype}" in
         *clib*)
            if [ -z "${_branch_identifier}" ]
            then
               log_warning "\"${_address}\" has no branch override identifier (branch \"${_branch}\"); skipping.
Run mulle-project-add-missing-branch-identifier to make it overridable."
               .continue
            fi

            [ -z "${_url}" ]    && fail "Can't figure out URL: ${line}"
            [ -z "${_branch}" ] && fail "Can't figure out branch: ${line}"
         ;;

         *)
            if [ -z "${_nodetype_identifier}" -o \
                 -z "${_url_identifier}"    -o \
                 -z "${_branch_identifier}" ]
            then
               log_warning "\"${_address}\" has no nodetype/url/branch override identifier (nodetype \"${_nodetype}\", url \"${_url}\", branch \"${_branch}\"); skipping.
Run mulle-project-add-missing-branch-identifier to make it overridable."
               .continue
            fi

            [ -z "${_user}" ]    && fail "Can't figure out user from URL ${_url}: ${line}"
            [ -z "${_repo}" ]    && fail "Can't figure out repo from URL ${_url}: ${line}"
            [ -z "${_host}" ]    && fail "Can't figure out host from URL ${_url}: ${line}"
         ;;
      esac

      r_add_line "${matching_lines}" "${line}"
      matching_lines="${RVAL}"
   .done

   #
   # CAVEAT: this may become unnecessary if a future mulle-sourcetree version
   # guarantees a stable dependency order for "list". For now it does not, so
   # sort here.
   #
   # mulle-sourcetree list emits dependencies in recursive pre-order, i.e. in
   # the line order of the (nested) sourcetree config files. That order changes
   # whenever a config is rewritten (add/remove/fetch), so the generated scope
   # file churns in git even though nothing changed. Sort the *source* lines by
   # address so the output is stable. Sorting here (instead of sorting the
   # generated file) is what keeps each dependency's comment together with its
   # export statement.
   #
   if [ ! -z "${matching_lines}" ]
   then
      matching_lines="`printf '%s\n' "${matching_lines}" | LC_ALL=C sort`"
   fi

   if [ -z "${matching_lines}" ]
   then
      log_warning "No dependencies matched (--user '${matching_users}', --repo '${matching_repos}').
Nothing to write to scope '${mapped_scope}'."
      return 0
   fi

   #
   # We have something to write, so it is safe to replace the old scope.
   #
   exekutor mulle-env \
               ${MULLE_TECHNICAL_FLAGS} \
               ${MULLE_ENV_FLAGS} \
            scope  \
               remove --if-exists "${mapped_scope}"  || fail "Could not remove old scope"

   if [ "${clobber}" = 'YES' ]
   then
      eval `mulle-env mulle-tool-env env`
      remove_file_if_present "${MULLE_ENV_ETC_DIR}/environment-${mapped_scope}.sh"
   fi

   #
   # Second pass: apply the mappings.
   #
   .foreachline line in ${matching_lines}
   .do
      [ -z "${line}" ] && .continue

      if ! project::sourcetree_parser::parse_nodetype_branch_tag_url "${line}"
      then
         .continue
      fi

      case "${_nodetype}" in
         *clib*)
            [ -z "${_url}" ]    && fail "Can't figure out URL: ${line}"
            [ -z "${_branch}" ] && fail "Can't figure out branch: ${line}"

            log_verbose "Mapped branch ${C_MAGENTA}${C_BOLD}${mapped_branch}${C_VERBOSE} for ${C_RESET_BOLD}${_url}"

            exekutor mulle-env \
                        ${MULLE_TECHNICAL_FLAGS} \
                        ${MULLE_ENV_FLAGS} \
                     environment  \
                        --scope "${mapped_scope}" \
                        set "${_branch_identifier}" "${mapped_branch}" "${_address} branch: ${_branch}"
         ;;

         *)
            [ -z "${_user}" ]    && fail "Can't figure out user from URL ${_url}: ${line}"
            [ -z "${_repo}" ]    && fail "Can't figure out repo from URL ${_url}: ${line}"

            mapped_url="https://${_host}/${_user}/${_repo%.git}.git"

            log_verbose "Map ${C_RESET_BOLD}${mapped_url}${C_VERBOSE} to ${C_RESET_BOLD}${_url}"

            [ -z "${_nodetype_identifier}" ] && fail "Can't figure out node identifier: ${line}"
            [ -z "${_host}" ]                && fail "Can't figure out host from URL ${_url}: ${line}"

            exekutor mulle-env \
                        ${MULLE_TECHNICAL_FLAGS} \
                        ${MULLE_ENV_FLAGS} \
                     environment  \
                        --scope "${mapped_scope}" \
                        set "${_nodetype_identifier}" "git" "${_address} nodetype: ${_nodetype}" &&
            exekutor mulle-env \
                        ${MULLE_TECHNICAL_FLAGS} \
                        ${MULLE_ENV_FLAGS} \
                     environment  \
                        --scope "${mapped_scope}" \
                        set "${_url_identifier}" "${mapped_url}" "${_address} url: ${_url}" &&
            exekutor mulle-env \
                        ${MULLE_TECHNICAL_FLAGS} \
                        ${MULLE_ENV_FLAGS} \
                     environment  \
                        --scope "${mapped_scope}" \
                        set "${_branch_identifier}" "${mapped_branch}" "${_address} branch: ${_branch}"
         ;;
      esac

      mapped_count=$(( mapped_count + 1 ))
   .done

   log_verbose "Mapped ${mapped_count} dependenc$([ ${mapped_count} -eq 1 ] && echo y || echo ies) to scope ${C_RESET_BOLD}${mapped_scope}"
}


main()
{
   local OPTION_SCOPE
   local OPTION_BRANCH
   local OPTION_USERS
   local OPTION_REPOS
   local OPTION_CLOBBER='YES'
   local OPTION_FIX='YES'
   local OPTION_FETCH='YES'

   #
   # simple flag handling
   #
   while [ $# -ne 0 ]
   do
      if options_technical_flags "$1"
      then
         shift
         continue
      fi

      case "$1" in
         -f|--force)
            MULLE_FLAG_MAGNUM_FORCE='YES'
            OPTION_FIX='YES'
            OPTION_FETCH='YES'
         ;;

         --fix)
            OPTION_FIX='YES'
         ;;

         --no-fix|--no-repair)
            OPTION_FIX='NO'
         ;;

         --fetch)
            OPTION_FETCH='YES'
         ;;

         --no-fetch)
            OPTION_FETCH='NO'
         ;;

         -h*|--help|help)
            usage
         ;;

         --version)
            printf "%s\n" "${MULLE_EXECUTABLE_VERSION}"
            exit 0
         ;;

         --append)
            OPTION_CLOBBER='NO'
         ;;

         --mulle)
            r_colon_concat "${OPTION_USERS}" 'Mulle*'
            OPTION_USERS="${RVAL}"
            r_colon_concat "${OPTION_USERS}" 'mulle-*'
            OPTION_USERS="${RVAL}"

            r_colon_concat "${OPTION_REPOS}" '!mintomic*'
            OPTION_REPOS="${RVAL}"
            r_colon_concat "${OPTION_REPOS}" '!*farmhash*'
            OPTION_REPOS="${RVAL}"
            r_colon_concat "${OPTION_REPOS}" '*'
            OPTION_REPOS="${RVAL}"
         ;;

         --branch)
            [ $# -eq 1 ] && usage "Missing argument to \"$1\""
            shift

            OPTION_BRANCH="$1"
         ;;

         --repo)
            [ $# -eq 1 ] && usage "Missing argument to \"$1\""
            shift

            r_colon_concat "${OPTION_REPOS}" "$1"
            OPTION_REPOS="${RVAL}"
         ;;

         --scope)
            [ $# -eq 1 ] && usage "Missing argument to \"$1\""
            shift

            OPTION_SCOPE="$1"
         ;;

         --user)
            [ $# -eq 1 ] && usage "Missing argument to \"$1\""
            shift

            r_colon_concat "${OPTION_USERS}" "$1"
            OPTION_USERS="${RVAL}"
         ;;

         -*)
            usage "Unknown flag \"$1\""
         ;;

         *)
            break
         ;;
      esac

      shift
   done

   options_setup_trace "${MULLE_TRACE}" && set -x

   include "project::sourcetree-parser" || exit 1

   produce_environment "${OPTION_BRANCH:-prerelease}" \
                       "${OPTION_SCOPE:-host-ci-${OPTION_BRANCH:-prerelease}}" \
                       "${OPTION_USERS}" \
                       "${OPTION_REPOS}" \
                       "${OPTION_CLOBBER}" \
                       "${OPTION_FIX}" \
                       "${OPTION_FETCH}"
}



call_with_flags "main" "${MULLE_PROJECT_CI_SETTINGS_FLAGS}" "$@"
