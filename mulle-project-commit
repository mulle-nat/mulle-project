#! /usr/bin/env mulle-bash
# shellcheck shell=bash

[ "${TRACE}" = 'YES' -o "${MULLE_PROJECT_COMMIT_TRACE}" = 'YES' ] && set -x && : "$0" "$@"


MULLE_EXECUTABLE_VERSION="0.0.0"


if [ -z "${MULLE_PROJECT_LIBEXEC_DIR}" ]
then
   r_get_libexec_dir "${MULLE_EXECUTABLE}" "mulle-project" "mulle-project-git.sh"
   MULLE_PROJECT_LIBEXEC_DIR="${RVAL}"
fi


print_flags()
{
   echo "   -f                 : force operation"
   echo "   -m|--message <msg> : commit message to use when creating new commit"
   echo "   --                 : arguments after -- are passed to the git commit"
   echo "   --always-amend     : always amend the commit [dangerous]"
   echo "   --boring           : all files are considered to be boring"
   echo "   --boring-file <p>  : add a pattern to the boring file list (repeatable)"
   echo "   --only-boring      : only commit if all changes are boring (implies --safe-amend)"
   echo "   --ignore-untracked : ignore untracked files"
   echo "   --no-amend         : never amend, just create a new commit [most safe]"
   echo "   --no-diff          : don't diff non-boring changes"
   echo "   --only-amend       : fail, if an amend is not possible"
   echo "   --safe-amend       : amend if unpushed/untagged, else new commit (default)"

   options_technical_flags_usage \
                "              : "
}


usage()
{
   [ $# -ne 0 ] && log_error "$*"


   cat <<EOF >&2
Usage:
   mulle-project-commit [flags]

   Amends the last commit with boring changes (mulle-sde upgrade output in
   "share" and "reflect"), if that commit is safe to rewrite: not pushed,
   not tagged and not a merge. Otherwise a new commit is created instead,
   and non-boring changes always create a new one.

   Give new commits a message with \`-m <message>\` like git. Not needed for
   \`--only-amend\`, which never creates one.

Example:
      mulle-project-commit -m "boring changes to mulle-sde files"

Flags:
EOF
   print_flags | LC_ALL=C sort >&2

   exit 1
}


main()
{
   local MULLE_FLAG_MAGNUM_FORCE='NO'

   # technical flags
   local MULLE_TRACE
   local MULLE_FLAG_EXEKUTOR_DRY_RUN='NO'
   local MULLE_FLAG_LOG_LOCAL='NO'
   local MULLE_FLAG_LOG_DEBUG='NO'
   local MULLE_FLAG_LOG_EXEKUTOR='NO'
   local MULLE_FLAG_LOG_FLUFF='NO'
   local MULLE_FLAG_LOG_SCRIPTS='NO'
   local MULLE_FLAG_LOG_SETTINGS='NO'
   local MULLE_FLAG_LOG_VERBOSE='NO'
   local MULLE_FLAG_LOG_MERGE='NO'
   local MULLE_TRACE_POSTPONE='NO'

   local OPTION_IGNORE_UNTRACKED
   local OPTION_AMEND='DEFAULT'
   local OPTION_STATUS
   local OPTION_DIFF='YES'
   local OPTION_BUMP
   local OPTION_BORING
   local OPTION_BORING_FILES
   local OPTION_ONLY_BORING
   local OPTION_MESSAGE

   local pass_args
   local _pattern
   #
   # simple flag handling
   #
   while [ $# -ne 0 ]
   do
      if options_technical_flags "$1"
      then
         shift
         continue
      fi

      case "$1" in
         -f|--force)
            MULLE_FLAG_MAGNUM_FORCE='YES'
         ;;

         -h*|--help|help)
            usage
         ;;

         -m|--message)
            [ $# -eq 1 ] && fail "missing parameter for \"$1\""
            shift

            OPTION_MESSAGE="$1"
         ;;

         --amend)
            OPTION_AMEND='YES'
         ;;

         --no-amend)
            OPTION_AMEND='NO'
         ;;

         --safe-amend)
            OPTION_AMEND='SAFE'
         ;;

         --only-amend)
            OPTION_AMEND='ONLY'
         ;;

         --bump-if-needed)
            OPTION_BUMP='YES'
         ;;

         -u|--ignore-untracked)
            OPTION_IGNORE_UNTRACKED='YES'
         ;;

         --boring)
            OPTION_BORING='YES'
         ;;

         --boring-file)
            [ $# -eq 1 ] && fail "missing parameter for \"$1\""
            shift
            # convert glob-like pattern to regex (. -> \., * -> .*)
            _pattern="${1//./\\.}"
            _pattern="${_pattern//\*/.*}"
            if [ -z "${OPTION_BORING_FILES}" ]
            then
               OPTION_BORING_FILES="${_pattern}"
            else
               OPTION_BORING_FILES="${OPTION_BORING_FILES}|${_pattern}"
            fi
         ;;

         --only-boring)
            OPTION_ONLY_BORING='YES'
            OPTION_AMEND='SAFE'
         ;;

         --diff)
            OPTION_DIFF='YES'
         ;;

         --no-diff)
            OPTION_DIFF='NO'
         ;;

         --status)
            OPTION_STATUS='YES'
         ;;

         --version)
            printf "%s\n" "${MULLE_EXECUTABLE_VERSION}"
            exit 0
         ;;

         --)
            pass_args='YES'
            shift
            break
         ;;

         -*)
            usage "Unknown flag \"$1\""
         ;;

         *)
            break
         ;;
      esac

      shift
   done

   options_setup_trace "${MULLE_TRACE}" && set -x

   # Check for unused arguments (not after --)
   if [ $# -ne 0 -a "${pass_args}" != 'YES' ]
   then
      fail "Unexpected arguments: $*. Use -- to pass arguments to git commit, or -m for commit message."
   fi

   . "${MULLE_PROJECT_LIBEXEC_DIR}/mulle-project-git.sh" || exit 1

   #
   # to catch added files so they aren't untracked
   # need to grab this from mulle-sde environment somehow, but for now
   # its hardcoded.
   #
   exekutor git add --ignore-errors \
                      .mulle/share \
                      .mulle/etc/env/environment-host-ci-*.sh \
                      cmake/share \
                      cmake/reflect \
                      src/reflect \
                      */.mulle/share \
                      */.mulle/etc/env/environment-host-ci-*.sh \
                      */cmake/share \
                      */cmake/reflect \
                      */src/reflect \
                      */*/.mulle/share \
                      */*/.mulle/etc/env/environment-host-ci-*.sh \
                      */*/cmake/share \
                      */*/cmake/reflect \
                      */*/src/reflect \
                      cola \
                      overview.dot.svg \
                      .github/workflows \
                      .gitattributes \
                      .gitignore \
                      .travis.yml \
                      .travis.d \
                      .ackrc 2> /dev/null


   local changes

   changes="`rexekutor git status -s `"
   if [ -z "${changes}" ]
   then
      log_info "There are no changes."
      return
   fi

   if [ "${OPTION_IGNORE_UNTRACKED}" = 'YES' ]
   then
      changes="`rexekutor git status -s ${status_options} --untracked-files=no `"
      if [ -z "${changes}" ]
      then
         log_info "There are no changes to tracked files."
         return
      fi
   fi

   local bad_changes

   bad_changes="`rexekutor grep -E '^UU' <<< "${changes}" `"
   if [ ! -z "${bad_changes}" ]
   then
      if [ "${OPTION_STATUS}" = 'YES' ]
      then
         MULLE_LOG_FAIL_ERROR_PREFIX=""
         MULLE_EXECUTABLE_FAIL_PREFIX=""
      fi
      fail "There is an unfinished merge here:
${C_RESET}${bad_changes# }"
   fi

   if [ "${OPTION_BORING}" != 'YES' ]
   then
      local ignore_patterns

      ignore_patterns="/share/|/reflect/|[[:space:]]cola/"
      ignore_patterns="${ignore_patterns}|/environment-host-.*\.sh"
      ignore_patterns="${ignore_patterns}|/environment-user-.*\.sh"
      ignore_patterns="${ignore_patterns}|\.github/workflows"
      ignore_patterns="${ignore_patterns}|\.gitignore|\.gitattributes"
      ignore_patterns="${ignore_patterns}|\.ackrc"
      ignore_patterns="${ignore_patterns}|README\.md"
      ignore_patterns="${ignore_patterns}|overview\.dot\.svg"

      if [ ! -z "${OPTION_BORING_FILES}" ]
      then
         ignore_patterns="${ignore_patterns}|${OPTION_BORING_FILES}"
      fi

      local interesting_changes

      interesting_changes="`grep -E -v "${ignore_patterns}" <<< "${changes}" `"
      if [ ! -z "${interesting_changes}" ]
      then
         if [ "${OPTION_ONLY_BORING}" = 'YES' ]
         then
            log_info "Non-boring changes detected, not committing:
${C_RESET}${interesting_changes# }"
            return 1
         fi

         if [ "${OPTION_STATUS}" = 'YES' ]
         then
            MULLE_LOG_FAIL_ERROR_PREFIX=""
            MULLE_EXECUTABLE_FAIL_PREFIX=""
         fi

         if [ -z "${OPTION_MESSAGE}" ]
         then
            _log_warning "There are possibly interesting changes that may need a commit message:
${C_RESET}${interesting_changes# }"

            if [ "${OPTION_DIFF}" = 'YES' ]
            then
               local line

               .foreachline line in ${interesting_changes}
               .do
                  r_trim_whitespace "${line#*\ }"
                  rexekutor git diff -r HEAD -- "${RVAL}"
               .done
            fi

            if [ "${MULLE_FLAG_MAGNUM_FORCE}" != 'YES' ]
            then
               fail "Not proceeding because of diffs (use -f to override)"
            fi
         fi

         # change to regular commit
         log_verbose "Interesting changes detected, will not amend (would have ammended with --boring)"
         OPTION_AMEND='NO'
      fi
   fi


#   if [ "${OPTION_BUMP}" = 'YES' ]
#   then


   if [ "${OPTION_STATUS}" != 'YES' ]
   then
      local commit_options

      #
      # If an amend is impossible, decide what to do based on the mode:
      #
      #   --only-amend : amending is mandatory, so fail and explain why we
      #                  cannot amend (never ask for a commit message).
      #   --boring     : never ask the user for a commit message; explain
      #                  why we couldn't amend and create a new boring
      #                  commit with a default message instead.
      #
      local cannot_amend_reason

      cannot_amend_reason=""
      if ! project::git::can_amend
      then
         project::git::r_cannot_amend_reason
         cannot_amend_reason="${RVAL}"
      fi

      if [ "${OPTION_AMEND}" = 'ONLY' -a ! -z "${cannot_amend_reason}" ]
      then
         fail "Cannot amend the last commit because ${cannot_amend_reason}."
      fi

      if [ -z "${OPTION_MESSAGE}" -a "${OPTION_BORING}" = 'YES' ]
      then
         if [ ! -z "${cannot_amend_reason}" ]
         then
            log_info "Cannot amend the last commit because ${cannot_amend_reason}, \
creating a new boring commit instead."
         fi
         OPTION_MESSAGE="boring changes"
      fi

      project::git::r_commit_options "${OPTION_AMEND}" "" "${OPTION_MESSAGE}"
      commit_options="${RVAL}"

      case "${commit_options}" in
         *--amend*)
         ;;

         *)
            if [ -z "${OPTION_MESSAGE}" ]
            then
               fail "Need a commit message for this commit (use -m <message>)"
            fi
         ;;
      esac

      log_verbose "Add changes and commit..."

      exekutor git add -u || exit 1

      set -- git commit "$@"

      local option

      .foreachline option in ${commit_options}
      .do
         set -- "$@" "${option}"
      .done

      exekutor "$@"
   else
      if project::git::can_amend
      then
         log_info "There are changes to amend"
      else
         log_info "There are changes to commit"
      fi
   fi
}


call_with_flags "main" "${MULLE_PROJECT_COMMIT_FLAGS}" "$@"
